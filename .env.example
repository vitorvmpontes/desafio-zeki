# Copie este arquivo para .env e ajuste se necessário.
# Os valores abaixo já funcionam com o docker-compose.yml deste repositório.

POSTGRES_USER=continua
POSTGRES_PASSWORD=continua
POSTGRES_DB=continua
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://continua:continua@localhost:5432/continua

# --- Chatbot text-to-SQL (api/chat_sql.py, opcional) ------------------------
# Sem estas duas variáveis, o resto da API funciona normalmente -- só o
# endpoint POST /chat responde 503 ("Chat não configurado").
#
# 1) DATABASE_URL_READONLY -- role Postgres DEDICADO e SOMENTE LEITURA, NUNCA
#    o mesmo usuário de DATABASE_URL acima. Rode db/readonly_role.sql UMA VEZ
#    contra o banco pra criar o role "continua_readonly" usado abaixo (ver
#    esse arquivo para instruções com/sem Docker):
DATABASE_URL_READONLY=postgresql://continua_readonly:continua_readonly@localhost:5432/continua
#
# 2) GEMINI_API_KEY -- chave do Google Gemini (usada só para traduzir a
#    pergunta em SQL, api/chat_sql.py::gerar_sql). Obtenha uma gratuitamente
#    em https://aistudio.google.com/apikey e cole abaixo (deixe em branco
#    pra manter o chat desabilitado).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
